{
	"name": "helenchong.dev",
	"description": "Helen Chong's developer portfolio and blog website.",
	"author": "Helen Chong",
	"repository": {
		"type": "git",
		"url": "https://git.helenchong.dev/helenchong/helenchong.dev.git"
	},
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-quiet": "npm run build -- --quiet",
		"dev": "npm run build-quiet -- --serve",
		"clean": "rm -rf _site/ .rumdl_cache/",
		"re": "npm run clean && npm run build-quiet",
		"re-dev": "npm run clean && npm run dev",
		"lint:biome": "npx @biomejs/biome lint",
		"lint:rumdl": "npx rumdl check",
		"lint:dprint": "npx dprint check",
		"lint": "npm run lint:biome && npm run lint:rumdl && npm run lint:dprint",
		"format:biome": "npx @biomejs/biome format --write",
		"format:rumdl": "npx rumdl fmt",
		"format:dprint": "npx dprint fmt",
		"format": "npm run format:biome && npm run format:dprint && npm run format:dprint"
	},
	"type": "module",
	"dependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.1.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"@uncenter/eleventy-plugin-toc": "^2.1.2",
		"@zachleat/details-utils": "^3.0.0",
		"eleventy-plugin-vento": "^7.0.0",
		"eleventy-plugin-wordcount-extended": "^0.2.1",
		"luxon": "^3.7.2",
		"markdown-it-anchor": "^10.0.0",
		"markdown-it-attrs": "^5.0.1",
		"markdown-it-bracketed-spans": "^1.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"dprint": "^0.58.0",
		"rumdl": "^0.2.78"
	},
	"allowScripts": {
		"dprint@0.58.0": true
	}
}
